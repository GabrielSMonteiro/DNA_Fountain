{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar TCC (PDF)",
            "type": "shell",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .\\compilar.ps1",
            "options": {
                "cwd": "${workspaceFolder}/Relatório"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Compilar Rápido (Apenas 1x pdflatex)",
            "type": "shell",
            "command": "pdflatex -interaction=nonstopmode -synctex=1 main.tex",
            "options": {
                "cwd": "${workspaceFolder}/Relatório"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
